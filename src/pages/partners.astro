---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
---

<Layout title="Sponsor">
    <section class="py-20 bg-background-primary min-h-screen">
        <Container>
            <div class="text-center mb-16 animate-fade-in">
                <h1 class="text-5xl font-bold text-accent-primary mb-6">
                    I nostri Partner
                </h1>
                <p class="text-xl text-gray-600 max-w-3xl mx-auto text-balance">
                    Collaborazioni istituzionali e convenzioni riservate ai
                    soci: le aziende ed enti che sostengono la cultura e la
                    nostra associazione, alcuni con sconti dedicati a chi fa
                    parte di Canta Rei APS.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <Card
                    class="flex flex-col h-full hover:shadow-xl transition-shadow duration-300"
                >
                    <div class="flex justify-center mb-8 h-32 items-center">
                        <img
                            src="/assets/eplanetlogo.svg"
                            alt="Logo Eplanet Cinemas"
                            class="max-h-full max-w-[80%] object-contain bg-[#2C2C2C] rounded-lg p-4"
                        />
                    </div>
                    <div class="flex-grow space-y-4">
                        <div class="text-center">
                            <h2
                                class="text-2xl font-bold text-text-primary mb-1"
                            >
                                Eplanet Cinemas
                            </h2>
                            <p class="text-gray-500 text-sm mb-1">
                                King &amp; La Torre — Palermo
                            </p>
                            <p
                                class="text-accent-primary font-medium text-sm uppercase tracking-wide"
                            >
                                Convenzione 100% online
                            </p>
                        </div>

                        <div class="text-gray-700 space-y-4 leading-relaxed">
                            <p>
                                Ogni socio riceve sul cellulare la propria <strong
                                    >Tessera Digitale Canta Rei APS</strong
                                >: basta mostrarla dal display in cassa prima
                                di richiedere i biglietti.
                                <br /><em class="text-sm text-gray-500"
                                    >Valida per tutto l'anno fino al
                                    15/12/2026.</em
                                >
                            </p>

                            <div class="space-y-2">
                                <div
                                    class="flex justify-between items-center bg-white rounded-lg border border-gray-200 px-4 py-2.5"
                                >
                                    <span class="text-gray-600 text-sm"
                                        >Lunedì – Giovedì</span
                                    >
                                    <span
                                        class="font-bold text-accent-primary"
                                        >€ 5,00</span
                                    >
                                </div>
                                <div
                                    class="flex justify-between items-center bg-white rounded-lg border border-gray-200 px-4 py-2.5"
                                >
                                    <span class="text-gray-600 text-sm"
                                        >Venerdì, Sabato e Domenica</span
                                    >
                                    <span
                                        class="font-bold text-accent-primary"
                                        >€ 7,00</span
                                    >
                                </div>
                                <div
                                    class="flex justify-between items-center bg-white rounded-lg border border-gray-200 px-4 py-2.5"
                                >
                                    <span class="text-gray-600 text-sm"
                                        >Proiezioni Dolby Atmos</span
                                    >
                                    <span
                                        class="font-bold text-accent-primary"
                                        >€ 7,50</span
                                    >
                                </div>
                            </div>

                            <p class="text-sm text-gray-500">
                                La tariffa è riservata al socio e a un massimo
                                di 3 familiari dello stesso nucleo (2 adulti e
                                2 bambini).
                            </p>

                            <details
                                class="group bg-white rounded-lg border border-gray-200"
                            >
                                <summary
                                    class="flex justify-between items-center font-medium cursor-pointer list-none p-4 text-accent-primary hover:bg-gray-50 transition-colors rounded-lg select-none"
                                >
                                    <span>Esclusioni e note</span>
                                    <span
                                        class="transition-transform group-open:rotate-180"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            ><path d="m6 9 6 6 6-6"></path></svg
                                        >
                                    </span>
                                </summary>
                                <div
                                    class="text-gray-600 p-4 pt-0 text-sm border-t border-gray-100 mt-2"
                                >
                                    <p>
                                        Sono escluse dalla promozione le prime
                                        visioni, gli eventi speciali/Film
                                        Gold, i film con prezzo imposto dal
                                        distributore, le proiezioni 3D e i
                                        periodi natalizio e pasquale.
                                    </p>
                                </div>
                            </details>
                        </div>
                    </div>
                    <div class="mt-8 text-center pt-6 border-t border-gray-200">
                        <Button
                            href="https://www.eplanetcinemas.it"
                            target="_blank"
                            variant="primary"
                        >
                            Visita il sito Eplanet Cinemas
                        </Button>
                    </div>
                </Card>

                <Card
                    class="flex flex-col h-full hover:shadow-xl transition-shadow duration-300"
                >
                    <div class="flex justify-center mb-8 h-32 items-center">
                        <img
                            src="/assets/trenitalialogo.svg"
                            alt="Logo Trenitalia"
                            class="max-h-full max-w-[80%] object-contain"
                        />
                    </div>
                    <div class="flex-grow space-y-4">
                        <div class="text-center">
                            <h2
                                class="text-2xl font-bold text-text-primary mb-1"
                            >
                                Trenitalia for Business
                            </h2>
                            <p
                                class="text-accent-primary font-medium text-sm uppercase tracking-wide"
                            >
                                Tariffe dedicate ai soci sulle Frecce
                            </p>
                        </div>

                        <div class="text-gray-700 space-y-4 leading-relaxed">
                            <div class="grid grid-cols-2 gap-4">
                                <div
                                    class="border-2 border-dashed border-accent-primary/30 rounded-xl p-4 bg-accent-primary/5 text-center"
                                >
                                    <p
                                        class="text-3xl font-bold text-accent-primary"
                                    >
                                        10%
                                    </p>
                                    <p
                                        class="text-xs text-gray-500 uppercase font-bold tracking-widest mt-1"
                                    >
                                        Sconto fisso Frecce
                                    </p>
                                </div>
                                <div
                                    class="border-2 border-dashed border-accent-primary/30 rounded-xl p-4 bg-accent-primary/5 text-center"
                                >
                                    <p
                                        class="text-3xl font-bold text-accent-primary"
                                    >
                                        20%
                                    </p>
                                    <p
                                        class="text-xs text-gray-500 uppercase font-bold tracking-widest mt-1"
                                    >
                                        Benvenuto (primi 30 gg)
                                    </p>
                                </div>
                            </div>

                            <p class="text-sm text-gray-500">
                                Sconto fisso valido su tutti i biglietti delle
                                Frecce (Frecciarossa, Frecciargento,
                                Frecciabianca), a cui si aggiunge un 20% di
                                benvenuto nei primi 30 giorni dall'attivazione.
                            </p>

                            <ul class="list-disc pl-5 space-y-1 text-sm">
                                <li>
                                    Cambi illimitati e rimborsi facilitati
                                    prima della partenza
                                </li>
                                <li>Scelta del posto gratuita</li>
                                <li>
                                    +10% di punti extra accreditati sulla
                                    propria CartaFRECCIA personale
                                </li>
                            </ul>

                            <details
                                class="group bg-white rounded-lg border border-gray-200"
                            >
                                <summary
                                    class="flex justify-between items-center font-medium cursor-pointer list-none p-4 text-accent-primary hover:bg-gray-50 transition-colors rounded-lg select-none"
                                >
                                    <span>Come attivare lo sconto</span>
                                    <span
                                        class="transition-transform group-open:rotate-180"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            ><path d="m6 9 6 6 6-6"></path></svg
                                        >
                                    </span>
                                </summary>
                                <div
                                    class="text-gray-600 p-4 pt-0 text-sm border-t border-gray-100 mt-2"
                                >
                                    <ol class="list-decimal pl-5 space-y-2">
                                        <li>
                                            Controlla la tua casella email
                                            (anche nello SPAM): troverai
                                            un'email d'invito inviata da
                                            Trenitalia.
                                        </li>
                                        <li>
                                            Apri la mail e imposta la tua
                                            password.
                                        </li>
                                        <li>
                                            Accedi al sito o all'App
                                            Trenitalia con il tuo profilo:
                                            vedrai automaticamente le tariffe
                                            scontate dedicate all'associazione
                                            e potrai prenotare in completa
                                            autonomia.
                                        </li>
                                    </ol>
                                </div>
                            </details>
                        </div>
                    </div>
                    <div class="mt-8 text-center pt-6 border-t border-gray-200">
                        <Button
                            href="https://www.trenitalia.com/it/trenitalia-for-business.html"
                            target="_blank"
                            variant="primary"
                        >
                            Scopri Trenitalia for Business
                        </Button>
                    </div>
                </Card>

                <Card
                    class="flex flex-col h-full hover:shadow-xl transition-shadow duration-300"
                >
                    <div class="flex justify-center mb-8 h-32 items-center">
                        <img
                            src="/assets/logo-sbc.png"
                            alt="Logo Sicily by Car"
                            class="max-h-full max-w-[80%] object-contain bg-white/50 rounded-lg p-2"
                        />
                    </div>
                    <div class="flex-grow space-y-4">
                        <div class="text-center">
                            <h2
                                class="text-2xl font-bold text-text-primary mb-1"
                            >
                                Sicily by Car S.p.A.
                            </h2>
                            <p
                                class="text-accent-primary font-medium text-sm uppercase tracking-wide"
                            >
                                Partnership esclusiva per associati
                            </p>
                        </div>

                        <div class="text-gray-700 space-y-4 leading-relaxed">
                            <p>
                                Sconto del <strong>10%</strong> sulla tariffa base
                                e sugli extra per tutti i nostri associati.
                                <br /><em class="text-sm text-gray-500"
                                    >Valido per noleggi con ritiro in Italia
                                    fino al 22/10/2026.</em
                                >
                            </p>

                            <details
                                class="group bg-white rounded-lg border border-gray-200"
                            >
                                <summary
                                    class="flex justify-between items-center font-medium cursor-pointer list-none p-4 text-accent-primary hover:bg-gray-50 transition-colors rounded-lg select-none"
                                >
                                    <span>Scopri di più sull'azienda</span>
                                    <span
                                        class="transition-transform group-open:rotate-180"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            ><path d="m6 9 6 6 6-6"></path></svg
                                        >
                                    </span>
                                </summary>
                                <div
                                    class="text-gray-600 p-4 pt-0 text-sm border-t border-gray-100 mt-2"
                                >
                                    <p class="mb-2">
                                        Fondata nel 1963, Sicily by Car vanta
                                        una flotta di oltre 15.000 veicoli e
                                        presenza in tutti i principali aeroporti
                                        italiani.
                                    </p>
                                    <ul class="list-disc pl-5 space-y-1">
                                        <li>
                                            Noleggio auto, furgoni e veicoli
                                            elettrici
                                        </li>
                                        <li>Tariffe mensili e plurimensili</li>
                                        <li>Noleggio con conducente</li>
                                    </ul>
                                </div>
                            </details>

                            <div
                                class="border-2 border-dashed border-accent-primary/30 rounded-xl p-6 bg-accent-primary/5 text-center mt-6"
                            >
                                <p
                                    class="text-sm text-gray-500 mb-2 uppercase font-bold tracking-widest"
                                >
                                    Codice Convenzione
                                </p>
                                <code
                                    class="block text-3xl font-mono font-bold text-accent-primary mb-4 select-all bg-white py-2 rounded border border-gray-200 mx-auto max-w-[200px]"
                                    >CNCANTA25</code
                                >

                                <Button
                                    href="https://www.sicilybycar.it/index.aspx?conv=CNCANTA25"
                                    target="_blank"
                                    variant="primary"
                                    class="w-full"
                                >
                                    Prenota ora con lo sconto
                                </Button>
                                <p class="text-xs text-gray-500 mt-3">
                                    Richiesto documento di iscrizione al ritiro.
                                </p>
                            </div>
                        </div>
                    </div>
                </Card>

                <Card
                    class="flex flex-col h-full hover:shadow-xl transition-shadow duration-300"
                >
                    <div class="flex justify-center mb-8 h-32 items-center">
                        <img
                            src="/assets/logo-unipa.png"
                            alt="Logo Università degli Studi di Palermo"
                            class="max-h-full max-w-[80%] object-contain"
                        />
                    </div>
                    <div class="flex-grow space-y-4">
                        <h2
                            class="text-2xl font-bold text-center text-text-primary"
                        >
                            Università degli Studi di Palermo
                        </h2>
                        <div class="text-gray-700 space-y-4 leading-relaxed">
                            <p>
                                Da oggi <strong>Canta Rei APS</strong> è ufficialmente
                                attiva come ente accreditato per i <strong
                                    >tirocini universitari UNIPA</strong
                                >!
                            </p>
                            <p>
                                Un nuovo passo importante, sancito dalla
                                convenzione quinquennale, che apre le porte a
                                studentesse e studenti interessati a fare
                                esperienza nel mondo della musica e
                                dell’organizzazione eventi.
                            </p>
                        </div>
                    </div>
                    <div class="mt-8 text-center pt-6 border-t border-gray-200">
                        <Button
                            href="https://www.unipa.it"
                            target="_blank"
                            variant="primary"
                        >
                            Visita il sito UNIPA
                        </Button>
                    </div>
                </Card>

                <Card
                    class="flex flex-col h-full hover:shadow-xl transition-shadow duration-300"
                >
                    <div class="flex justify-center mb-8 h-32 items-center">
                        <img
                            src="/assets/logo-new-european-bauhaus.png"
                            alt="Logo New European Bauhaus"
                            class="max-h-full max-w-[80%] object-contain"
                        />
                    </div>
                    <div class="flex-grow space-y-4 text-center">
                        <h2
                            class="text-2xl font-bold text-text-primary"
                        >
                            New European Bauhaus
                        </h2>
                        <div class="text-gray-700 leading-relaxed max-w-2xl mx-auto">
                            <p>
                                Un'iniziativa creativa e interdisciplinare promossa dalla <strong>Commissione Europea</strong> che collega il Green Deal ai nostri spazi di vita. Unisce sostenibilità, inclusione ed estetica per immaginare e costruire insieme un futuro migliore per tutti.
                            </p>
                        </div>
                    </div>
                    <div class="mt-8 text-center pt-6 border-t border-gray-200">
                        <Button
                            href="https://new-european-bauhaus.europa.eu/index_en"
                            target="_blank"
                            variant="primary"
                        >
                            Scopri l'iniziativa
                        </Button>
                    </div>
                </Card>
            </div>
        </Container>
    </section>
</Layout>